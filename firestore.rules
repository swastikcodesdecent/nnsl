rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is an authenticated administrator
    function isAdmin() {
      return request.auth != null;
    }

    // Players collection rules
    match /players/{playerId} {
      // Authenticated admins can view, search, and manage all registrations
      // Public visitors cannot read other players' records
      allow read: if isAdmin();

      // Any visitor can submit a new player registration
      allow create: if true;

      // Only authenticated admins can update player status, notes, or delete records
      allow update, delete: if isAdmin();
    }

    // Admins collection rules (supports first-login admin provisioning)
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    // Tournament configuration / settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
